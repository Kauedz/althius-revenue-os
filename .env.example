# ==============================================================================
# ALTHIUS REVENUE OS — VARIÁVEIS DE AMBIENTE E CHAVES DE PROVEDORES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Banco de Dados, Autenticação, RLS e Realtime)
# ------------------------------------------------------------------------------
# "real" = login e dados do banco (padrão). "demo" = protótipo v18 com dados fictícios e troca de papel.
VITE_ALTHIUS_MODO=real
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui

# ------------------------------------------------------------------------------
# 2. UNIPILE (Canal de Conexão Efêmero para WhatsApp, LinkedIn, Instagram e E-mail)
# Nota: Todos os contatos e conversas são gravados no nosso banco Supabase.
# Trocar estas chaves não apaga nem afeta nenhum dado histórico do CRM.
# ------------------------------------------------------------------------------
UNIPILE_DSN=https://api1.unipile.com:13262
UNIPILE_API_KEY=seu_token_unipile_aqui
UNIPILE_WEBHOOK_SECRET=seu_webhook_secret_aqui

# ------------------------------------------------------------------------------
# 3. APIFY (Pool das 5 Contas Centrais como Provedores da Althius)
# O backend balanceia a carga e faz rodízio automático entre as 5 contas.
# ------------------------------------------------------------------------------
APIFY_TOKEN_1=apify_api_token_conta_01
APIFY_TOKEN_2=apify_api_token_conta_02
APIFY_TOKEN_3=apify_api_token_conta_03
APIFY_TOKEN_4=apify_api_token_conta_04
APIFY_TOKEN_5=apify_api_token_conta_05

# ------------------------------------------------------------------------------
# 4. HERMES AGENT & LLM (Orquestrador de IA e os 4 Agentes)
# Padrão: 'codex-luna' (Pode ser alterado a qualquer momento aqui ou no código)
# ------------------------------------------------------------------------------
HERMES_MODEL=codex-luna
HERMES_API_BASE_URL=https://api.openai.com/v1
HERMES_API_KEY=sua_chave_llm_aqui

# ------------------------------------------------------------------------------
# 5. REDIS & FILAS (BullMQ para Enriquecimento, Scraping e Disparos)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
