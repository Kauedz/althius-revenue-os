{
  "name": "althius-revenue-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "npx supabase test db",
    "db:start": "npx supabase start",
    "db:reset": "npx supabase db reset",
    "v18:sync": "node scripts/v18/convert.mjs",
    "guardas": "node scripts/guardas.mjs",
    "v18:verificar": "node scripts/v18/convert.mjs --verificar",
    "verificar": "node scripts/v18/convert.mjs --verificar && tsc --noEmit && npx supabase db reset && npx supabase test db && vitest run && vite build",
    "prepare": "git config core.hooksPath .githooks",
    "docker:env": "node scripts/docker/gerar-env.mjs",
    "docker:env:demo": "node scripts/docker/gerar-env.mjs --demo",
    "docker:subir": "node scripts/docker/garantir-executores.mjs && docker compose up -d --build",
    "docker:parar": "docker compose down",
    "docker:chave-unipile": "node scripts/docker/trocar-chave-unipile.mjs",
    "criar-superadmin": "node scripts/docker/criar-superadmin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.67.1",
    "bullmq": "^5.41.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.6.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "parse5": "^7.3.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
