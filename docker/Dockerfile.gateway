# Gateway do modelo de IA (ADR 0050): o Hermes de cada cliente fala com ele; a chave real do provedor vem do cofre.
# Só Node: sem dependências, sem build. Rede interna, nenhuma porta publicada.
FROM node:22-alpine
WORKDIR /app
COPY src/server/gateway ./src/server/gateway
COPY src/server/cofre ./src/server/cofre
USER node
EXPOSE 3300
CMD ["node", "src/server/gateway/principal.ts"]
