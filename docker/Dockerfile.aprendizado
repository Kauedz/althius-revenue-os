# Aprendizado compartilhado entre contas (ADR 0052): recalcula os padrões e emite sugestões a cada poucas horas.
# Só Node: sem dependências, sem build.
FROM node:22-alpine
WORKDIR /app
COPY src/server/aprendizado ./src/server/aprendizado
USER node
CMD ["node", "src/server/aprendizado/principal.ts"]
