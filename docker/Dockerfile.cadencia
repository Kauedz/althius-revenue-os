# Motor de cadência (worker). Só Node: sem dependências, sem build. Roda o TypeScript direto (Node 22.18+).
# Copia as pastas inteiras (o principal importa de ../unipile e ../cofre).
FROM node:22-alpine
WORKDIR /app
COPY src/server/cadencia ./src/server/cadencia
COPY src/server/unipile ./src/server/unipile
COPY src/server/cofre ./src/server/cofre
USER node
CMD ["node", "src/server/cadencia/principal.ts"]
