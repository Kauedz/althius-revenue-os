# Receptor de webhooks (Unipile). Só Node: sem dependências, sem build. Roda o TypeScript direto (Node 22.18+).
FROM node:22-alpine
WORKDIR /app
COPY src/server/webhooks/unipile.ts src/server/webhooks/banco.ts src/server/webhooks/servidor.ts src/server/webhooks/principal.ts ./
USER node
EXPOSE 3100
CMD ["node", "principal.ts"]
