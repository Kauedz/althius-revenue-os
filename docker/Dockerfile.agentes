# Harness dos agentes (worker): entrega os pedidos dos canais ao Hermes Agent de cada cliente. Só Node, sem dependências.
FROM node:22-alpine
WORKDIR /app
COPY src/server/agentes/harness.ts src/server/agentes/hermes.ts src/server/agentes/hosts.ts src/server/agentes/prompts.ts src/server/agentes/principal.ts ./
USER node
CMD ["node", "principal.ts"]
