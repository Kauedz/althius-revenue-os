# Coleta de sinais (ADR 0055): busca os sinais de compra fora (Apify) para as contas dos clientes e entrega ao banco.
# Só Node: sem dependências, sem build. Copia as pastas inteiras (o principal importa de ../cofre e ../providers).
FROM node:22-alpine
WORKDIR /app
COPY src/server/sinais ./src/server/sinais
COPY src/server/providers ./src/server/providers
COPY src/server/cofre ./src/server/cofre
USER node
CMD ["node", "src/server/sinais/principal.ts"]
